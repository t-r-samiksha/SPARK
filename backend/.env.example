# Postgres connection string used by Prisma (see prisma/schema.prisma)
DATABASE_URL="postgresql://spark:spark@localhost:5432/spark?schema=public"

# HTTP server port
PORT=3000

# Bank Root CA Ed25519 key (32-byte seed, base64url unpadded) — signs device certificates.
# See docs/crypto.md "Open question" re: whether this is the same key as BANK_SIGNING_KEY_SEED
# or a separate operational key. Kept separate here per the recommended split (cold Root CA key
# vs. operational key) until that's confirmed. TODO: replace with KMS/HSM-backed key management.
BANK_ROOT_CA_KEY_SEED=

# Bank operational Ed25519 key (32-byte seed, base64url unpadded) — signs purse tokens and trust
# attestations. TODO: replace with KMS/HSM-backed key management.
BANK_SIGNING_KEY_SEED=
