# SPARK operations console — environment configuration.
# Copy to .env.local and fill in. Never commit real secrets.

# Backend API base URL.
# Default (omit): relative "/api/v1" — same-origin, with the Vite dev proxy forwarding
# /api to the backend (vite.config.ts, VITE_PROXY_TARGET). For a deployment served from a
# different origin, set an absolute URL here AND ensure the backend accepts the origin
# (the fastify backend sets no CORS headers today).
VITE_API_BASE_URL=/api/v1

# Vite dev proxy target (only read by the dev server; harmless in builds).
# VITE_PROXY_TARGET=http://localhost:3000

# Shared secret for admin endpoints (X-Admin-Key header), matching the backend's
# ADMIN_API_KEY. Without it the console shows a clear "admin key not configured" state.
VITE_ADMIN_KEY=

# Optional display label for the environment (shown in the status bar).
VITE_ENV=dev
